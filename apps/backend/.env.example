# Sao chép file này thành apps/backend/.env (pnpm bootstrap làm việc đó giúp bạn).
# KHÔNG commit file .env. Backend tự đọc .env khi khởi động (spring.config.import).
# Định dạng: KEY=value, không bọc ngoặc kép, không có "export".

# JWT: chuỗi bí mật >= 64 ký tự cho HS512. pnpm bootstrap tự sinh nếu để trống.
SIGNER_KEY=

# Database: phải khớp với Postgres trong docker-compose.yml
DB_URL=jdbc:postgresql://localhost:5432/chat_system
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Gmail SMTP: chỉ cần khi gửi OTP / quên mật khẩu. Tạo App Password tại
# https://myaccount.google.com/apppasswords
EMAIL_ACCOUNT=your@gmail.com
EMAIL_APP_PASSWORD_NAME=RChat
EMAIL_APP_PASSWORD=your_app_password
