{
  "name": "chat-system",
  "private": true,
  "description": "Monorepo: apps/backend (Spring Boot) + apps/frontend (React/Vite). Script ở đây chỉ là lối tắt, không phải pnpm workspace.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bootstrap": "node scripts/run.mjs setup",
    "dev": "node scripts/run.mjs dev",
    "dev:db": "node scripts/run.mjs dev db",
    "dev:be": "node scripts/run.mjs dev be",
    "dev:fe": "node scripts/run.mjs dev fe",
    "db:stop": "node scripts/run.mjs dev stop",
    "build": "node scripts/run.mjs build",
    "test:be": "node scripts/run.mjs mvnw -B test",
    "format:be": "node scripts/run.mjs mvnw -q spotless:apply"
  }
}
