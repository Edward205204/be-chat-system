{
  "name": "chat-system",
  "private": true,
  "description": "Monorepo: apps/backend (Spring Boot) + apps/frontend (React/Vite). Script ở đây chỉ là lối tắt, không phải pnpm workspace.",
  "scripts": {
    "dev": "pwsh -NoProfile -File scripts/dev.ps1",
    "dev:db": "pwsh -NoProfile -File scripts/dev.ps1 -Only db",
    "dev:be": "pwsh -NoProfile -File scripts/dev.ps1 -Only be",
    "dev:fe": "pwsh -NoProfile -File scripts/dev.ps1 -Only fe",
    "db:stop": "pwsh -NoProfile -File scripts/dev.ps1 -Stop",
    "build": "pwsh -NoProfile -File scripts/build.ps1",
    "test:be": "cd apps/backend && mvnw.cmd -B test"
  }
}
